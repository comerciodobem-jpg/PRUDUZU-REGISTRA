# Banco de dados PostgreSQL/Neon. Nunca versionar o valor real.
DATABASE_URL=

# Segredo para assinatura da sessão. Obrigatório fora do modo de teste.
AUTH_SECRET=

# Preview demonstrativo. Manter false em produção real.
DEMO_MODE=false

# Regra conservadora: quem registrou não aprova a própria produção.
ALLOW_SELF_REVIEW=false

# URL pública opcional para metadados/PWA.
NEXT_PUBLIC_APP_URL=http://localhost:3000
